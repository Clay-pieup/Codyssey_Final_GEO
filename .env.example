# 이 파일을 복사해서 .env 를 만들고 값을 채웁니다.
#   Windows: copy .env.example .env
# .env 는 .gitignore 로 막혀 있어 저장소에 올라가지 않습니다. 이 파일(.env.example)에는 실제 키를 쓰지 않습니다.

# Gemini API 키 (팀장에게 받거나 Google AI Studio에서 발급)
GEMINI_API_KEY=

# 사용할 Gemini 모델 이름. 비워 두면 ai/gemini_client.py 의 기본값을 사용
GEMINI_MODEL=

# 호출 1회 시간 제한(초). 비우면 60
GEMINI_TIMEOUT_SEC=

# 진단 설정 (ai/diagnosis.py). 비우면 괄호 안 기본값
# 웹 검색 사용 1/0 (1). 무료 키는 웹 검색 할당량이 없어 로컬 테스트 때는 0
GEMINI_USE_SEARCH=
# 질문마다 반복 횟수 (3). 무료 키 테스트 때 1로 줄이면 호출이 1/3
GEMINI_REPEAT=
# 동시에 보낼 호출 수 (3). 유료 키는 10 정도까지 늘려도 됨
GEMINI_CONCURRENCY=
# 한도 초과(429) 때 기다렸다가 다시 시도하는 횟수 (3)
GEMINI_RATE_LIMIT_RETRIES=
# 자동 추가 질의(Agent) 기준 언급률 % (30)
AGENT_THRESHOLD=

# (서버) 진단 결과를 보낼 Make 웹훅 주소. 실제 주소는 비밀값이라 .env 와 Vercel 환경 변수에만 넣음
MAKE_WEBHOOK_URL=
